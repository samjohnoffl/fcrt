# Environment variables for Financial Crime AI Red Team
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.

# ----- Database -----
# PostgreSQL connection string (Cloud SQL via Cloud SQL Connector recommended)
DATABASE_URL=postgres://user:password@localhost:5432/fincrime_redteam?sslmode=disable

# ----- Gemini -----
# Preferred: Gemini API key from Google AI Studio (no GCP project or billing).
# Get one at https://aistudio.google.com/apikey — takes precedence over VERTEX_PROJECT.
GEMINI_API_KEY=
# Alternative backend: Vertex AI (uses Application Default Credentials).
VERTEX_PROJECT=
VERTEX_LOCATION=us-central1
# Default model; can be overridden per request. Retired models (1.5 Pro, 2.5
# Flash) are rejected for new API keys, so this is a current structured-output model.
GEMINI_MODEL=gemini-3.8-flash

# ----- Authentication -----
# AUTH_MODE selects the auth backend:
#   local    (default) username/password -> signed session token
#   firebase Firebase ID tokens
#   none     NO AUTH — local dev only, every request is treated as admin
AUTH_MODE=local

# AUTH_USERS seeds the user directory on first boot (username:password:role).
# Roles: analyst (create/run) < admin (everything, incl. users + audit log).
# After the first boot, manage accounts in the app under Administration → Users.
# The defaults below are TEST credentials — change them before any public deploy.
AUTH_USERS=admin:admin:admin,analyst:analyst:analyst

# HMAC secret used to sign session tokens. MUST be a long random value in
# production (e.g. `openssl rand -hex 32`). Stored in Secret Manager on GCP.
AUTH_SESSION_SECRET=change-me-to-a-long-random-string

# Session token lifetime in hours (default 12).
AUTH_SESSION_TTL_HOURS=12

# ----- Firebase (only when AUTH_MODE=firebase) -----
FIREBASE_PROJECT=
# Path to Firebase Admin SDK service account JSON (for local dev only)
# In Cloud Run, use Application Default Credentials instead
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ----- API Server -----
API_PORT=8080
# Comma-separated allowed CORS origins (Firebase Hosting URL + local dev)
CORS_ORIGINS=http://localhost:5173,https://your-project.web.app

# ----- Worker -----
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_MAX_JOB_ATTEMPTS=5

# ----- Logging -----
LOG_LEVEL=info
